# --- Server ---
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Security ---
# MUST be a long random string in production
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789abcdef
ACCESS_TTL=30m
REFRESH_TTL_DAYS=7
# Set to true when serving over HTTPS
COOKIE_SECURE=false
MAX_BODY_SIZE=64kb
# Comma-separated origins allowed for CORS in production
CORS_ORIGINS=

# --- Seed accounts (used by `npm run seed`) ---
ADMIN_STUDENT_ID=admin
ADMIN_PASSWORD=Admin@2026
STUDENT_STUDENT_ID=student001
STUDENT_PASSWORD=Student@2026

# --- Simulation ---
SIM_DEFAULT_VOTERS=200
SIM_MAX_VOTERS=5000

# --- VoteForge AI Security Copilot ---
# Provider options: 'builtin' (Zero-API setup), 'openai', 'gemini', 'ollama', 'custom'
SECURITY_COPILOT_PROVIDER=builtin
SECURITY_COPILOT_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

